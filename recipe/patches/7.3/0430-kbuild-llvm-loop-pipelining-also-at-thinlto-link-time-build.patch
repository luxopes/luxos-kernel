From 390d6d437f33d5d86f65a042bc7f9775fa12171c Mon Sep 17 00:00:00 2001
From: LuxOS <luxos@lux-ai.cz>
Date: Thu, 26 Nov 2026 21:39:04 +0100
Subject: [PATCH] kbuild: LLVM loop pipelining, also at ThinLTO link time;
 build fix for bus master check

Adds -mllvm -enable-pipeliner (software pipelining of innermost loops)
like CachyOS's "Kbuild: Enable LLVM machine pipeliner". CachyOS adds it
next to GCC modulo scheduling, which LuxOS does not take, so the hunk did
not apply. With ThinLTO the machine code is generated by ld.lld, so the
option is passed to the linker too, otherwise it would have no effect.

The same CachyOS commit also guards the AMD bus master check (from
"ACPI: processor: Disable bus master check for AMD") with CONFIG_X86, as
boot_cpu_data exists only on x86.

Own LuxOS patch based on CachyOS/linux 7.3/cachy commit 8f28aedefce3.
---
 Makefile                      | 7 +++++++
 drivers/acpi/processor_idle.c | 2 ++
 2 files changed, 9 insertions(+)

diff --git a/Makefile b/Makefile
index b2b79dd71..6419f9ec4 100644
--- a/Makefile
+++ b/Makefile
@@ -941,6 +941,13 @@ KBUILD_CFLAGS += -Os
 KBUILD_RUSTFLAGS += -Copt-level=s
 endif
 
+# LuxOS (from CachyOS): LLVM software pipelining of innermost loops (overlaps loop iterations); with
+# ThinLTO the code is generated in the linker, so the option goes to ld.lld as well
+KBUILD_CFLAGS += $(call cc-option,-mllvm -enable-pipeliner)
+ifdef CONFIG_LTO_CLANG
+KBUILD_LDFLAGS += -mllvm -enable-pipeliner
+endif
+
 # Always set `debug-assertions` and `overflow-checks` because their default
 # depends on `opt-level` and `debug-assertions`, respectively.
 KBUILD_RUSTFLAGS += -Cdebug-assertions=$(if $(CONFIG_RUST_DEBUG_ASSERTIONS),y,n)
diff --git a/drivers/acpi/processor_idle.c b/drivers/acpi/processor_idle.c
index b470e9493..854349418 100644
--- a/drivers/acpi/processor_idle.c
+++ b/drivers/acpi/processor_idle.c
@@ -1162,6 +1162,7 @@ void acpi_processor_power_init(struct acpi_processor *pr)
 	if (disabled_by_idle_boot_param())
 		return;
 
+#ifdef CONFIG_X86
 	/*
 	 * The bus master check on AMD is observed to be very costly and results
 	 * in not only increased power consumption, but also lots of CPU cycles
@@ -1172,6 +1173,7 @@ void acpi_processor_power_init(struct acpi_processor *pr)
 		bm_check_disable = true;
 		pr_info("Enabled processor.bm_check_disable for AMD cpuidle\n");
 	}
+#endif
 
 	if (!acpi_processor_get_power_info(pr))
 		pr->flags.power_setup_done = 1;
