From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LuxOS <luxos@lux-ai.cz>
Date: Fri, 27 Nov 2026 03:20:00 +0100
Subject: [PATCH] kbuild: clang: no -Werror=unused-command-line-argument for
 external modules

Out-of-tree modules built by DKMS against a clang-built kernel get every
CLANG_FLAGS option. Their makefiles were written for gcc, which silently
ignores unused options: the NVIDIA 470 legacy driver adds -MD to ccflags-y
next to kbuild's own -Wp,-MMD, and clang then stops with
"argument unused during compilation: '-MD'". Keep the check for the kernel
itself and drop it when KBUILD_EXTMOD is set, so DKMS modules build as they
do with a gcc-built kernel.
---
--- a/scripts/Makefile.clang
+++ b/scripts/Makefile.clang
@@ -37,6 +37,10 @@
 CLANG_FLAGS	+= -Werror=unknown-warning-option
 CLANG_FLAGS	+= -Werror=ignored-optimization-argument
 CLANG_FLAGS	+= -Werror=option-ignored
+# LuxOS: not for external modules (DKMS). Their makefiles were written for gcc, which
+# ignores unused options; the NVIDIA 470 driver passes -MD next to kbuild's -Wp,-MMD.
+ifeq ($(KBUILD_EXTMOD),)
 CLANG_FLAGS	+= -Werror=unused-command-line-argument
+endif
 KBUILD_CPPFLAGS	+= $(CLANG_FLAGS)
 export CLANG_FLAGS
